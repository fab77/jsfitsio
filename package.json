{
  "name": "jsfitsio",
  "description": "JavaScript/TypeScript library for reading and writing FITS files in Node.js and the browser.",
  "version": "3.0.0-snapshot",
  "keywords": [
    "fits",
    "fits-io",
    "astronomy",
    "astrophysics",
    "science",
    "data-format",
    "browser",
    "typescript"
  ],
  "author": "Fabrizio Giordano (fab77)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/fab77/jsfitsio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fab77/jsfitsio.git"
  },
  "bugs": {
    "url": "https://github.com/fab77/jsfitsio/issues",
    "email": "fabriziogiordano77@gmail.com"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib-esm/index.d.ts",
      "import": "./lib-esm/index.js",
      "require": "./dist/jsfitsio.cjs"
    },
    "./package.json": "./package.json"
  },
  "module": "./lib-esm/index.js",
  "main": "./dist/jsfitsio.cjs",
  "types": "./lib-esm/index.d.ts",
  "unpkg": "dist/jsfitsio.min.js",
  "jsdelivr": "dist/jsfitsio.min.js",
  "files": [
    "lib-esm/",
    "dist/",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "shx rm -rf dist lib-esm",
    "build": "npm run clean && tsc && webpack --mode=production",
    "prod": "npm run build",
    "dev": "npm run clean && tsc && webpack --mode=development --watch --progress",
    "webtest": "cp dist/* webtest/; node server.cjs",
    "test": "jest",
    "test:remote": "jest --config jest.remote.config.js",
    "test:all": "npm test && npm run test:remote",
    "test:watch": "jest --watch",
    "test:esm": "tsc -m es6 test.ts && node test.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^22.20.1",
    "jest": "^29.0.0",
    "shx": "^0.3.4",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.0.0",
    "ts-loader": "^9.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "dependencies": {
    "cross-fetch": "^3.1.5"
  },
  "browser": {
    "fs": false,
    "node:fs/promises": false,
    "node:fs": false,
    "fs/promises": false
  }
}
